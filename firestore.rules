rules_version = '2';

// =============================================================================
// P0.0 — Firestore security rules.
//
// WHAT THESE REPLACE
// ------------------
//     match /{document=**} { allow read, write: if true; }
//
// Every document in the project was readable and writable by anyone on the
// internet holding the public API key — which is committed to this repository.
// That is not only a data-exfiltration hole. It is the reachable prompt-injection
// channel S4 and S18 describe: the knowledge and company-brain documents are
// stringified into every outbound prompt, so an attacker who can write them can
// dictate what the system says to customers. It is also how the send-mode switch
// is flipped, because `oauth_connections` is a top-level collection and the
// action gateway takes the LAST matching row's token.
//
// WHY DENY-ALL IS THE CORRECT RULE HERE
// -------------------------------------
// The browser bundle imports `firebase/auth` and never `firebase/firestore`:
// every read and write the product performs goes through the Express API. So no
// legitimate *client* touches Firestore at all, and the honest rule is that none
// may. Anything narrower would be permitting access nobody uses, which is surface
// with no corresponding function.
//
// THESE RULES ARE NOW DEPLOYABLE. THEY WERE NOT, AND THIS IS WHY THEY ARE.
// ------------------------------------------------------------------------
// This block used to read "DO NOT DEPLOY THESE RULES YET". The server reached
// Firestore with the *client* SDK, unauthenticated, so deploying deny-all would
// have denied the server too and stopped the application. That workaround and
// this exposure were the same fact seen from two sides: rules could not be
// closed because the server depended on them being open.
//
// The blocker is gone, and not by acquiring the credentials it was waiting on.
// Nothing in this repository reads or writes Firestore any more. The document
// collections moved to the PostgreSQL instance the system already runs — see
// `server/store/index.ts` — which also ended the two-datastore split where the
// producer wrote Postgres and the consumer read Firestore. `server/firebase.ts`
// now initialises Firebase Auth and nothing else, and Auth is unaffected by
// these rules.
//
// So deny-all is not merely safe here, it is exact: there is no reader left to
// deny. The Admin-SDK migration this file used to prescribe is not needed and
// is not happening.
//
// WHAT STILL NEEDS A CONSOLE, AND IS NOT MADE UNNECESSARY BY THE ABOVE
// -------------------------------------------------------------------
//   1. `firebase deploy --only firestore:rules`. Until this runs, the live
//      database is still world-readable and world-writable regardless of what
//      this file says. A rules file in a repository is a proposal.
//   2. Rotate the `apiKey` and OAuth client id in firebase-applet-config.json
//      and purge them from git history. Closing the rules does not un-publish a
//      credential that has been public.
//   3. Audit the live Firestore for documents an anonymous party may already
//      have written, and treat what is there as untrusted. This system no longer
//      reads any of it, which removes the ongoing risk but not the question of
//      what was written while the door was open.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Default: deny. Every path not matched below falls through to this, so a
    // collection added later is closed until somebody deliberately opens it —
    // the opposite of the previous rule, where a new collection was public the
    // moment it was created.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // NOT A RULE — a template, deliberately left inert.
    //
    // If a future client ever needs to read Firestore directly, this is the shape
    // it must take, and it mirrors `server/middleware/tenant.ts` exactly so the
    // two cannot drift:
    //
    //   - The signed token GRANTS. `request.auth.token.orgIds` (or `.orgId`) is
    //     the only source of authority, because the datastore is the thing being
    //     protected and cannot also be the thing that authorises access to it.
    //   - The datastore may only REVOKE. An ABSENT member document is not a
    //     denial — most users legitimately have no record, since the claim is the
    //     grant. A PRESENT document that does not say ACTIVE is a denial.
    //   - `oauth_connections` stays denied to every client regardless. It holds
    //     provider tokens; there is no client that has any business reading it.
    //
    // Written out rather than described, so that enabling it is a matter of
    // deleting the deny-all above rather than of designing something under time
    // pressure:
    //
    //   function tokenOrgs() {
    //     return request.auth.token.orgIds is list
    //       ? request.auth.token.orgIds
    //       : (request.auth.token.orgId is string ? [request.auth.token.orgId] : []);
    //   }
    //
    //   function memberNotRevoked(orgId) {
    //     let path = /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    //     return !exists(path) || get(path).data.status == 'ACTIVE';
    //   }
    //
    //   function inOrg(orgId) {
    //     return request.auth != null
    //       && orgId in tokenOrgs()
    //       && memberNotRevoked(orgId);
    //   }
    //
    //   match /organizations/{orgId} {
    //     allow read: if inOrg(orgId);
    //     allow write: if false;              // server-only, even for members
    //     match /{sub=**} {
    //       allow read: if inOrg(orgId);
    //       allow write: if false;            // every write goes through the API
    //     }
    //   }
    //
    //   match /oauth_connections/{id} {
    //     allow read, write: if false;        // provider tokens; no client, ever
    //   }
    // -------------------------------------------------------------------------
  }
}

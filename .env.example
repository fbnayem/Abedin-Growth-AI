# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL Database Connection String
DATABASE_URL=

# --- P0.3: master autonomy gate -------------------------------
# The ONLY way to enable autonomous sending. Deliberately NOT settable through the
# application or its datastore, so a hostile write to the datastore can pause the
# system but can never start it. Fail-closed: anything other than exactly "true"
# leaves autonomous sending disabled.
AUTONOMY_ENABLED=false

# --- P0.4: local development auth escape hatch -----------------
# Allows unauthenticated API access WITHOUT a Bearer token, for local development only.
# Ignored entirely when NODE_ENV=production, so setting it there has no effect.
# Leave false unless you are running locally without Firebase Auth configured.
ALLOW_ANONYMOUS_DEV_AUTH=false

# --- P0.14: webhook authenticity (fail closed if unset) --------
# Without these the webhook endpoints REJECT all requests. They are unauthenticated
# by necessity, so the signature is the only gate.
DOCUSIGN_WEBHOOK_SECRET=
# Shared token configured on the Google Pub/Sub push subscription (query param or bearer).
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# --- P1.1: tenant resolution ------------------------------------
# The organisation for a request is resolved from a Firebase custom claim on the verified
# ID token (`orgId`, or `orgIds` for a multi-tenant user). Grant one with:
#     node scripts/set-org-claim.mjs --email you@example.com --org acme
# Claims can only be written with Admin SDK credentials, which is what makes them a
# trustworthy grant: no API request can widen anyone's tenancy.
#
# DEV_DEFAULT_ORG_ID resolves every authenticated caller to one organisation, so the app is
# usable locally before any claims exist. It is IGNORED when NODE_ENV=production, so setting
# it in a production deployment does nothing. Leave it unset to require real claims.
DEV_DEFAULT_ORG_ID=

# Which tenants this process does BACKGROUND work for (outbox dispatch, lease reaping).
# A worker has no request and therefore no token to read a claim from. Comma separated.
# When unset, the organisations collection in the datastore is enumerated instead; when that
# is empty too, workers idle rather than guessing a tenant. Queued work is durable.
WORKER_ORG_IDS=

# The organisation the in-memory seed store mirrors into PostgreSQL. Unset means the mirror
# does not run, rather than inventing a "Default Org" nobody chose.
SEED_ORGANIZATION_ID=

# One-time migration aid. Before P1.1 the global kill switch was stored inside one
# organisation's settings; it now lives at system_settings/circuitBreaker. Set this to that
# organisation's id so an operator pause recorded at the old location is still honoured.
# It can only ADD a pause, never clear one. Clear this once the pause has been re-recorded.
LEGACY_KILL_SWITCH_ORG_ID=

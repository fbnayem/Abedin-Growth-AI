# Configuration this application reads. Copy to `.env` and fill in.
#
# `.env` is gitignored. This file is not, and must never carry a real value —
# it exists so a fresh clone knows what to set, and so that adding a variable
# is visible in a diff.
#
# ---------------------------------------------------------------------------
# Firebase Auth
# ---------------------------------------------------------------------------
# These four replaced `firebase-applet-config.json`, which was TRACKED IN GIT
# and carried the apiKey and the OAuth client id. Vite inlines an imported JSON
# module, so every value in it was compiled into the browser bundle whether or
# not anything read it — and rotating them meant editing a tracked file and
# rebuilding, which is most of why "rotate the committed credentials" stayed
# undone across several audits.
#
# The VITE_-prefixed ones are read at BUILD time and DO reach the browser. That
# is correct and unavoidable: a web apiKey identifies a project to Google and
# has to be in the page. It is not a password, and the protection is the
# security rules, not the secrecy of this value.
#
# It still matters that these are rotatable, for two reasons the general case
# does not cover: while `firestore.rules` was `allow read, write: if true`, the
# public key WAS sufficient to read and write every document; and the same file
# carried the OAuth client id, which is what an attacker needs to build a
# convincing consent screen against this project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side. Used only to verify Google ID tokens, which needs no service
# account — `verifyIdToken` checks a JWT against Google's public certificates.
# If this is unset, NO request can be authenticated and every one is refused.
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The runtime role. Least privilege: SELECT/INSERT/UPDATE/DELETE on the
# application tables, SELECT on drizzle.__drizzle_migrations, and no CREATE.
DATABASE_URL=
# The owning role. Used ONLY by `npm run migrate` and `npm run db:grants`.
# Never set this in a running application.
MIGRATION_DATABASE_URL=

# TLS. The connection is verified before a byte is written to it, and refuses
# to connect if neither of these is configured. Supply the CA to upgrade from
# trust-on-first-use pinning to real verification.
DATABASE_TLS_EXPECTED_CN=
# DATABASE_CA_CERT_FILE=

# ---------------------------------------------------------------------------
# SAFE REBUILD MODE — every one of these defaults to false and must stay false
# until the corresponding path has been proved end to end. They gate
# IRREVERSIBLE, externally-visible actions: mail to real people, meetings in
# real calendars, charges to real cards.
# ---------------------------------------------------------------------------
REAL_EMAIL_SEND_ENABLED=false
REAL_CALENDAR_CREATE_ENABLED=false
REAL_PAYMENT_ENABLED=false
REAL_SIGNATURE_ENABLED=false
REAL_LINKEDIN_SEND_ENABLED=false
AUTONOMY_ENABLED=false
USE_GENAI_FOR_REPLIES=false

# Development only, and ignored in production regardless of what it says here.
ALLOW_ANONYMOUS_DEV_AUTH=false

# ---------------------------------------------------------------------------
# Unsubscribe (S26)
# ---------------------------------------------------------------------------
# Signs the per-contact unsubscribe token in the List-Unsubscribe header. At
# least 32 characters, random, and NOT shared with SESSION_SECRET — a token
# forgeable from a leaked session key would let anyone unsubscribe anyone.
#
# Rotating it invalidates every unsubscribe link already in a recipient's
# inbox, so rotate only for a compromise. Already-recorded unsubscribes are
# unaffected: they are a flag on the contact, not a token.
#
# WITHOUT THIS, AND WITHOUT APP_URL AS AN https ORIGIN, EMAIL_SEND REFUSES.
# That is deliberate. Mail a recipient cannot opt out of is the failure this
# closes, and the permissive reading — send anyway, omit the header — is the
# one that fails silently.
UNSUBSCRIBE_SECRET=

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The checkout amount. NO DEFAULT, and the route refuses without both.
#
# This was `unit_amount: 500000, currency: 'usd'` written into
# server/routes/stripe.routes.ts -- USD $5,000 for a product the rest of the
# system prices from shared/domain/pricing.ts, in a currency that module does
# not model (CURRENCIES is ['GBP']).
#
# It is configuration rather than a corrected literal because the right number
# is a commercial decision: "Enterprise Onboarding" at $5,000 may be a genuine
# one-off unrelated to the subscription tier, or a leftover from a template.
# A figure invented in code looks authoritative, which is the failure the
# price book exists to prevent.
#
# MINOR UNITS -- pence or cents, an integer. "4.99" is refused because it is
# ambiguous between pounds and pence and one reading is a hundredfold error.
STRIPE_CHECKOUT_MINOR_UNITS=
STRIPE_CHECKOUT_CURRENCY=
DOCUSIGN_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Read by the SERVER. It does NOT control the client build: `npm run build` forces
# NODE_ENV=production before Vite loads, because Vite would otherwise read this line and emit a
# development React bundle (35% larger, dev-only warning paths). See scripts/build-client.mjs.
NODE_ENV=development
PORT=3000
# The public origin. Used to build unsubscribe links, so it must be an https
# origin (or http://localhost in development) and may contain only characters
# that are safe in a mail header and an href.
APP_URL=
SESSION_SECRET=

# S37 - Per-tenant model spend ceilings, in USD cents (the provider bills in USD), per UTC
# day and per UTC month. The defaults are deliberately low ($5 / $50): decide the budget
# rather than inherit an unbounded one (unset = 500 and 5000). 0 is legal and means no model spend. A malformed
# value refuses at startup. GET /api/spend shows the running totals against these.
TENANT_MODEL_SPEND_DAILY_LIMIT_CENTS=
TENANT_MODEL_SPEND_MONTHLY_LIMIT_CENTS=

# S27 - Sender identity (SPF/DKIM/DMARC) is read from DNS before an autonomous send. DKIM
# selectors to check at <selector>._domainkey.<domain>, comma-separated (unset = google).
DKIM_SELECTORS=
# Resolver addresses for those lookups, comma-separated (unset = the system's). Set this on a
# host whose configured resolvers refuse direct queries; a lookup that fails refuses the send.
DNS_RESOLVERS=
